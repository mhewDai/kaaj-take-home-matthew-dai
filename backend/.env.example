# Copy to .env and adjust as needed.

# Postgres (docker-compose default). For zero-infra local dev / tests you can use:
#   DATABASE_URL=sqlite:///./local.db
DATABASE_URL=postgresql+psycopg://kaaj:kaaj@localhost:5432/kaaj

# Comma-separated CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Per-lender evaluation retry policy used by the in-process workflow.
LENDER_EVAL_MAX_RETRIES=2
LENDER_EVAL_RETRY_BACKOFF_SECONDS=0.1
